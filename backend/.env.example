# These are configuration names only. Never commit an actual .env or credentials.
# This project reads process environment variables; .env is not auto-loaded.
DJANGO_DEBUG=false
# Required outside development; keep a private, stable random value.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
DB_NAME=jedel_group_db
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=
DB_PASSWORD=
# Optional production TLS, e.g. require or verify-full with PGSSLROOTCERT.
DB_SSLMODE=prefer
# For local HTTP development explicitly set DJANGO_DEBUG=true.
# Separate random credentials, each at least 32 characters. Empty = deny access.
# These are shared API scopes, NOT PostgreSQL credentials or per-user roles.
ERP_READ_TOKEN=
# Admin: all supported operations, including deletion.
ERP_WRITE_TOKEN=
# Buyer: read, catalog create/update, order create/amend; no deletion/status actions.
ERP_BUYER_TOKEN=
# Approver: read, approve, deliver, cancel; no catalog edits.
ERP_APPROVER_TOKEN=
# Opt in only after reviewing every affected subdomain and HSTS preload policy.
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_HSTS_PRELOAD=false
# Only scripts/test_postgres.py should configure the test database/cluster.
TEST_DB_NAME=test_jedel_api
