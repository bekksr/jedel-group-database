# Copy to backend/.env for automatic local configuration. Existing process variables take priority.
DJANGO_DEBUG=
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
CORS_ALLOWED_ORIGINS=
DB_NAME=
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_SSLMODE=
DJANGO_HSTS_INCLUDE_SUBDOMAINS=
DJANGO_HSTS_PRELOAD=
# Set only for an explicitly isolated jedel_dev database.
JEDEL_ISOLATED_DEVELOPMENT=

# Optional AI: keep disabled unless external usage is explicitly authorized.
AI_ENABLED=false
AI_PROVIDER=openai
OPENAI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=15
AI_MAX_OUTPUT_TOKENS=512
AI_DAILY_CALL_LIMIT=100
AI_USER_DAILY_CALL_LIMIT=20
