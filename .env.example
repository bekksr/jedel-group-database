# Generate both secrets locally; never commit the populated .env.
POSTGRES_PASSWORD=
DJANGO_SECRET_KEY=

# Optional provider configuration; leave disabled for ordinary catalog/tools.
AI_ENABLED=false
AI_PROVIDER=groq
AI_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=
AI_TIMEOUT_SECONDS=15
AI_MAX_OUTPUT_TOKENS=512
AI_DAILY_CALL_LIMIT=100
AI_USER_DAILY_CALL_LIMIT=20
AI_CHAT_REQUESTS_PER_MINUTE=5
