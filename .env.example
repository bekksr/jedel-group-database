# Generate both secrets locally; never commit the populated .env.
POSTGRES_PASSWORD=
DJANGO_SECRET_KEY=

# Gmail password recovery. Use a Google App Password; never use your account password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your-account@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-google-app-password
DEFAULT_FROM_EMAIL=Jedel.Group <your-account@gmail.com>
FRONTEND_BASE_URL=http://localhost:4200
PASSWORD_RESET_TIMEOUT=1800

# Optional provider configuration; leave disabled for ordinary catalog/tools.
AI_ENABLED=false
AI_PROVIDER=groq
AI_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=
AI_TIMEOUT_SECONDS=15
AI_MAX_OUTPUT_TOKENS=512
AI_DAILY_CALL_LIMIT=100
AI_USER_DAILY_CALL_LIMIT=20
AI_CHAT_REQUESTS_PER_MINUTE=5
APP_DB_PASSWORD=
